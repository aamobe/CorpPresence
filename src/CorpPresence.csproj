    <EmbeddedResource Include="CorpPresence/assets/mineral-recycling/powder-box-fill-40.png" LogicalName="CorpPresence.art.mineral.powder-box-fill-40.png" />
    <EmbeddedResource Include="CorpPresence/assets/mineral-recycling/powder-box-fill-60.png" LogicalName="CorpPresence.art.mineral.powder-box-fill-60.png" />
    <EmbeddedResource Include="CorpPresence/assets/mineral-recycling/powder-box-fill-80.png" LogicalName="CorpPresence.art.mineral.powder-box-fill-80.png" />
    <EmbeddedResource Include="CorpPresence/assets/mineral-recycling/powder-box-fill.png" LogicalName="CorpPresence.art.mineral.powder-box-fill.png" />
    <EmbeddedResource Include="CorpPresence/Presentation/Translations.json" LogicalName="CorpPresence.Translations.json" />
    <EmbeddedResource Include="CorpPresence/Presentation/Translations.Keys.json" LogicalName="CorpPresence.Translations.Keys.json" />
  </ItemGroup>
  <Target Name="CheckGameDirectory" BeforeTargets="ResolveReferences" Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')">
    <Error Text="Set GameManaged to the game's Probably Stolen_Data/Managed directory." />
  </Target>
  <Import Project="BuildIdentity.targets" />
</Project>
