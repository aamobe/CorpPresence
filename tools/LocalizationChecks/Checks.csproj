<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameManaged Condition="'$(GameManaged)' == ''">E:/steam/steamapps/common/Probably Stolen/Probably Stolen_Data/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Migration.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="MenuBaseline.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Localization/*.csv" Link="Localization/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Batch2Cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Batch3Cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Batch4Cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="DefinitionCases.json;DynamicCases.json;ConfigCases.json;CourierCases.json;Composed.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/CorpPresence/Presentation/L.cs" Link="L.cs" />
    <Compile Include="../../src/CorpPresence/Presentation/TextTranslations.cs" Link="TextTranslations.cs" />
    <Compile Include="../../src/CorpPresence/Presentation/OfficialTranslations.cs" Link="OfficialTranslations.cs" />
    <Compile Include="../../src/CorpPresence/Presentation/TranslationFormat.cs" Link="TranslationFormat.cs" />
    <Compile Include="../../src/CorpPresence/Presentation/ConfigDisplay.cs" Link="ConfigDisplay.cs" />
    <Compile Include="../../src/CorpPresence/Presentation/GoodsText.cs" Link="GoodsText.cs" />
    <Compile Include="../../src/CorpPresence/UI/MenuLabels.cs" Link="MenuLabels.cs" />
    <Compile Include="../../src/CorpPresence/Companies/Brand.cs" Link="Brand.cs" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManaged)/Newtonsoft.Json.dll" />
    <EmbeddedResource Include="../../src/CorpPresence/Presentation/Translations.json" LogicalName="CorpPresence.Translations.json" />
    <EmbeddedResource Include="../../src/CorpPresence/Presentation/Translations.Keys.json" LogicalName="CorpPresence.Translations.Keys.json" Condition="Exists('../../src/CorpPresence/Presentation/Translations.Keys.json')" />
  </ItemGroup>
</Project>
